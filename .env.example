# ── OpenAI (recommended for POC — cheap and no AWS setup needed) ─────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ── Bedrock (alternative — no separate API key needed) ───────────────────────
# CLAUDE_CODE_USE_BEDROCK=1
# AWS_REGION=ap-south-1
# AWS_BEARER_TOKEN_BEDROCK=<your-bedrock-bearer-token>
# AWS_ACCESS_KEY_ID=<your-aws-access-key-id>
# AWS_SECRET_ACCESS_KEY=<your-aws-secret-access-key>
# ANTHROPIC_MODEL=global.anthropic.claude-sonnet-4-6
# CLAUDE_CODE_SUBAGENT_MODEL=global.anthropic.claude-sonnet-4-6

# ── Direct Anthropic API (alternative) ───────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-5

# ── Output & logging ─────────────────────────────────────────────────────────
WORKSPACE_ROOT=./output
LOG_LEVEL=INFO
